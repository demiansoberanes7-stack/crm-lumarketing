# ============================================================
# LUMARK CRM — variables de entorno
# Copia este archivo a `.env` y reemplaza cada REEMPLAZA_...
# En producción estas variables van en tu plataforma de hosting
# (Hostinger / docker compose), no solo en el archivo.
# ============================================================

# --- Aplicación ---------------------------------------------
# URL pública de la instancia (con https en producción).
# De ella se construye la URL del webhook de WhatsApp.
APP_BASE_URL=REEMPLAZA_https://crm.tudominio.com

# Dominio para el HTTPS automático de Caddy (docker compose).
DOMAIN=REEMPLAZA_crm.tudominio.com

# --- Base de datos ------------------------------------------
# Docker compose usa el servicio `postgres` interno.
# Genera la contraseña con:  openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_password_de_postgres
DATABASE_URL=postgres://postgres:REEMPLAZA_password_de_postgres@postgres:5432/lumark

# --- Secretos de la aplicación ------------------------------
# Firma de sesiones. Genera con:  openssl rand -base64 32
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones

# Cifrado en reposo de tokens (AES-256-GCM).
# DEBE ser exactamente 32 bytes en base64 (44 caracteres).
# Genera con:  openssl rand -base64 32
ENCRYPTION_KEY=REEMPLAZA_clave_de_cifrado_base64

# --- WhatsApp (WAHA) ----------------------------------------
# Webhook verify token para WAHA.
# Genera con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_verificacion

# Versión de la Graph API (déjala así salvo que sepas por qué cambiarla).
META_GRAPH_API_VERSION=v25.0

# --- WAHA (WhatsApp HTTP API) -------------------------------
# El servidor WAHA corre en tu servidor propio, NO en Hostinger.
# URL pública del WAHA (ej: https://waha.tudominio.com)
WAHA_BASE_URL=REEMPLAZA_https://waha.tudominio.com
# API key de WAHA (configurada en docker-compose de WAHA)
WAHA_API_KEY=REEMPLAZA_api_key_waha

# --- Inteligencia artificial (opcional) ---------------------
# Sin token, el CRM funciona completo excepto Agente y Laboratorio.
# Crea una clave gratis en https://console.groq.com/keys y no la compartas.
# Los nombres OPENROUTER_* se conservan por compatibilidad; el endpoint es Groq.
# OPENROUTER_API_TOKEN=gsk_REEMPLAZA_clave_de_Groq
OPENROUTER_BASE_URL=https://api.groq.com/openai
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_JUDGE_MODEL=openai/gpt-oss-20b

# --- Canales ------------------------------------------------
# Canales encendidos, separados por coma.
# WhatsApp siempre está activo (via WAHA).
# Para encender Instagram y Messenger:
CHANNELS=whatsapp,instagram,messenger

# --- Operación (opcional) -----------------------------------
# Reabrir el registro público después de la primera organización.
# ALLOW_SIGNUP=true

# Milisegundos de agrupación de mensajes antes del turno del agente (default 6000).
# AGENT_COALESCE_MS=6000

# --- Cerebro externo (opcional) -----------------------------
# Si en vez del agente in-process prefieres tu propio bot:
# BOT_API_KEY=

# 008 - Directorio del volumen local de adjuntos (imágenes, docs, audios).
MEDIA_DIR=./.dev-media

# WhatsApp Cloud mediante Zernio (única vía de conexión en la UI).
# Introduce accountId, API key y signing secret en Ajustes > WhatsApp; las
# credenciales se guardan cifradas por negocio. Pon false para ocultarla.
WHATSAPP_ZERNIO_ENABLED=true
# Base de API oficial; sobreescribir solo para mocks locales.
# ZERNIO_BASE_URL=https://zernio.com/api/v1
# Para WAHA interno: hostname explícitamente autorizado, sin protocolo/puerto.
# Las credenciales/URL operativas se guardan desde Ajustes > WAHA.
# WAHA_TRUSTED_HOSTS=crm_waha

# --- Webhooks de salida (Ajustes > Webhooks) ------------------------------
# Todo webhook de salida DEBE ser https y apuntar a una IP pública: si no,
# cualquier URL puede apuntar a 169.254.169.254 y el CRM poste allí los datos
# del negocio. Lista blanca de hosts propios que sí pueden ir por http o caer
# dentro de tu red (n8n, Make self-hosted…), coma-separados y sin protocolo.
# WEBHOOK_TRUSTED_HOSTS=n8n.interno,tu-host.com

# ============================================================
# VPS DE BAJO CONSUMO (1-core / 2GB RAM / 20GB)
# ============================================================
# docker-compose.yml ya configura:
#   - PostgreSQL: shared_buffers=128MB, max_connections=30
#   - Node.js: --max-old-space-size=384
#   - Memory limits: app=768M, postgres=512M, caddy=128M
#   - Dashboard cache: 60s TTL por org+period
#   - SSE connections: max 5 por organizacion
#
# Si usas EasyPanel, configura los limites de memoria en la UI
# del servicio en vez de en docker-compose.yml.
#
# Total estimado: ~1.56GB de 2GB (440MB libres para picos).
